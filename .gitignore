!docs/handbook/public/screenshots/
!docs/handbook/public/media/
!docs/handbook/public/media/*.webm

# Docs output
docs/handbook/.vitepress/dist/
docs/handbook/.vitepress/cache/

# Logs and OS noise
*.log
logs/
npm-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
