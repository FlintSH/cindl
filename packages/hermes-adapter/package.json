{
  "name": "@cindl/hermes-adapter",
  "version": "1.1.0",
  "private": true,
  "description": "Version-aware adapter from the Hermes `hermes serve` backend (REST + JSON-RPC WebSocket) to Cindl contracts.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./upstream/*": "./upstream/*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "extract-upstream": "node scripts/extract-upstream.ts"
  },
  "dependencies": {
    "@cindl/contracts": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cindl/fixtures": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
