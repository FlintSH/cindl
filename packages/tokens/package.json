{
  "name": "@cindl/tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Shared semantic design tokens and licensed local fonts for every Cindl client.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./generated/tokens.css",
